# Cloud sync (Supabase) — optional. Without these the app runs local-only.
#
# Dev: copy to .env.local (gitignored) and Vite picks them up.
# Prod: set SUPABASE_URL / SUPABASE_ANON_KEY on the host; server.py injects
#       them into index.html at request time, so no rebuild is needed.
#
# The anon key is a public client key — RLS enforces per-user access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
